# ============================================================
# AI-Powered Academic Research Assistant - Environment Config
# ============================================================

# ── Gemini (DEFAULT — recommended) ──────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here   # Get from: aistudio.google.com
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite-preview                  # free-tier compatible; 1000 req/day

# ── Optional: OpenAI fallback ────────────────────────────────
OPENAI_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o

# ── Optional: Anthropic fallback ────────────────────────────
ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-20241022

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2     # HuggingFace sentence-transformers model

# Vector DB
CHROMA_PERSIST_DIR=./data/chroma_db

# Semantic Scholar API (free, optional key for higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# ArXiv settings
ARXIV_MAX_RESULTS=50

# App settings
APP_TITLE=AI Research Assistant & Grant Generator
LOG_LEVEL=INFO
